{
  "name": "pomodoro-flow",
  "private": true,
  "version": "2.0.0",
  "description": "A fast, offline-ready Pomodoro timer PWA with a session planner, per-session tasks, daily stats, and seven themes.",
  "keywords": [
    "pomodoro",
    "pomodoro-timer",
    "timer",
    "productivity",
    "focus",
    "pwa",
    "offline-first",
    "react",
    "vite",
    "typescript",
    "tailwindcss",
    "cloudflare-pages"
  ],
  "homepage": "https://github.com/hzd96/pomodoro-flow",
  "bugs": {
    "url": "https://github.com/hzd96/pomodoro-flow/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hzd96/pomodoro-flow.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && npx wrangler pages deploy dist"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
